# twinops — Environment Configuration
# Copy to .env and fill in. NEVER commit the real .env.

# --- Tianji ---
# Sign the analytics sessions; generate one with: openssl rand -hex 32
JWT_SECRET=<set-a-random-secret>
POSTGRES_PASSWORD=<set-a-random-password>
ALLOW_REGISTER=true
PUBLIC_URL=

# --- Portal links (defaults work on the Docker host) ---
KUMA_URL=http://127.0.0.1:3001
TIANJI_URL=http://127.0.0.1:12345
PORTAL_PORT=8080
